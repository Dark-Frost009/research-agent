# --------------------------------------------------
# Application
# --------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# Set to true for a public portfolio deployment.
# Disables live research and local shared-history features.
PUBLIC_DEMO_ONLY=false


# --------------------------------------------------
# LLM
# --------------------------------------------------

LLM_PROVIDER=
LLM_MODEL=

# Optional role-specific models.
# If blank, each falls back to LLM_MODEL.
LLM_WORKER_MODEL=
LLM_FINAL_MODEL=

LLM_API_KEY=


# --------------------------------------------------
# Web Search
# --------------------------------------------------

SEARCH_PROVIDER=tavily
TAVILY_API_KEY=


# --------------------------------------------------
# Research Limits
# --------------------------------------------------

# Total number of research iterations, including the initial pass.
MAX_RESEARCH_ITERATIONS=2

# Planner shaping limit.
MAX_SUB_QUESTIONS=5

# Whole-run search-query ceiling.
MAX_SEARCH_QUERIES_PER_RUN=8

# Maximum search queries allowed in one research iteration.
MAX_SEARCH_QUERIES_PER_ITERATION=5

# Maximum provider results returned for one search query.
MAX_SEARCH_RESULTS_PER_QUERY=5

# Maximum unique Sources retained across the whole research run.
MAX_SOURCES_PER_RUN=12

# Maximum source-fetch attempts across the whole research run.
MAX_SOURCE_FETCHES_PER_RUN=12

# Maximum LLM calls across the whole research run.
MAX_LLM_CALLS_PER_RUN=64

# Protected LLM calls reserved for finalization:
#   1. synthesis
#   2. A1.2 semantic verification
FINALIZATION_LLM_RESERVE=2


# --------------------------------------------------
# Network / Extraction
# --------------------------------------------------

REQUEST_TIMEOUT_SECONDS=15
MAX_RESPONSE_BYTES=2097152
MAX_TEXT_CHARS=100000
MAX_REDIRECTS=5